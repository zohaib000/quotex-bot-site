---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const faqs = [
  {
    category: "Getting Started",
    items: [
      { q: "What is Quotex Bot?", a: "Quotex Bot is a free Chrome extension that automates trading on Quotex (QXBroker) using the martingale strategy. It places trades automatically, tracks results, and adjusts your investment amounts based on your configured sequence." },
      { q: "Is Quotex Bot free to use?", a: "Yes! Quotex Bot is completely free to use on the Quotex demo account with all features available. Live real account trading requires a $20/month subscription via Gumroad." },
      { q: "Which browsers are supported?", a: "Quotex Bot works on Google Chrome and any Chromium-based browser. On mobile, it works via the Lemur Browser app for Android. iOS is not currently supported." },
      { q: "Do I need a Quotex account?", a: "Yes, you need a Quotex or QXBroker account. The bot works on both demo and live accounts. You can create a free Quotex demo account without any deposit." },
      { q: "How do I install Quotex Bot?", a: "Search for 'Quotex Bot' in the Chrome Web Store or use the direct install link. Click 'Add to Chrome' and confirm. The bot automatically opens as a sidebar when you visit Quotex." },
    ]
  },
  {
    category: "Trading & Strategy",
    items: [
      { q: "What is martingale strategy?", a: "Martingale is a trading strategy where you increase your investment after each losing trade. The idea is that when you eventually win, you recover all previous losses and make a profit. Quotex Bot automates this process completely." },
      { q: "What trading sequences can I use?", a: "You can use any combination of 'up' and 'down' directions. For example: up,down,up,down or up,up,down,down. The bot will execute trades in this order repeatedly. You can also choose from 4 built-in presets." },
      { q: "How do I set investment amounts?", a: "Enter your investment sequence as comma-separated numbers, e.g. 1,2,4,8 or 100,220,500,1100. The bot advances through these amounts on each loss and resets on win (unless compounding is enabled)." },
      { q: "What is Compounding Mode?", a: "When Compounding is ON, a winning trade advances to the next investment amount instead of resetting. This lets you grow your position on wins. When OFF (default), every win resets to the first investment amount." },
      { q: "What happens when the sequence ends?", a: "When the last investment amount is reached on a loss, the bot automatically cycles back to the first amount. On a win at the last position, it always resets to the first amount regardless of compounding setting." },
      { q: "Can I use custom sequences?", a: "Yes! You can enter any sequence of up/down directions and any investment amounts. You can also save up to 5 custom presets with names for quick access." },
      { q: "What currency pairs work with the bot?", a: "Quotex Bot works with all currency pairs available on Quotex/QXBroker — including USD, EUR, GBP, INR, PKR and all OTC pairs. It reads the trade result regardless of currency symbol." },
    ]
  },
  {
    category: "Risk Management",
    items: [
      { q: "How does Take Profit work?", a: "When Take Profit is enabled, the bot monitors your session net profit (wins minus losses). When net profit reaches your target amount, the bot stops automatically and shows an alert." },
      { q: "How does Stop Loss work?", a: "When Stop Loss is enabled, the bot monitors your session net loss (losses minus wins). When net loss reaches your limit, the bot stops automatically to protect your account." },
      { q: "What is Timer Stop?", a: "Timer Stop lets you set a duration in minutes. The bot will automatically stop trading after that time expires. A live countdown is shown on the trading page." },
      { q: "Can I use multiple auto-stop options together?", a: "Yes! You can combine any or all three — Take Profit, Stop Loss, and Timer. Whichever condition is met first will stop the bot." },
      { q: "What is the Pause Between Trades feature?", a: "You can set a fixed pause or random pause (between min/max seconds) between each trade. This makes the bot appear more natural and gives you control over trading frequency." },
    ]
  },
  {
    category: "Technical Questions",
    items: [
      { q: "What happens if I refresh the page while the bot is running?", a: "The browser will show a warning asking if you want to leave. If you confirm refresh, the bot stops and session stats reset. If you cancel, the bot continues running normally." },
      { q: "Can I have other tabs open while the bot runs?", a: "Yes! As long as the Quotex trading tab is open (not necessarily active) and the Trades panel is visible, the bot continues running." },
      { q: "Why must I keep the Trades panel visible?", a: "The bot reads your trade results from the Trades panel in the Quotex interface. If the panel is hidden, closed, or scrolled away, the bot cannot detect trade results and will malfunction." },
      { q: "Does the bot work on OTC pairs?", a: "Yes! Quotex Bot works perfectly on all OTC (Over The Counter) pairs as well as regular pairs. OTC pairs are available 24/7 even on weekends." },
      { q: "Can I run the bot on multiple Quotex tabs?", a: "No — running the bot on multiple tabs simultaneously can cause conflicts since they share the same extension storage. Always run on a single Quotex tab." },
      { q: "What happens if the bot loses connection?", a: "If the internet connection drops, trades may not execute. The bot will attempt to continue when connection is restored. Always monitor your session when trading live." },
    ]
  },
  {
    category: "Subscription & Account",
    items: [
      { q: "How do I subscribe for live trading?", a: "Click any 'Get Live Access' button and you'll be taken to the Gumroad checkout. Pay $20/month and use the same email in the Quotex Bot extension to verify your subscription." },
      { q: "How is my subscription verified?", a: "Each time you start live trading, the bot sends your email to our verification server which checks Gumroad for an active subscription linked to that email." },
      { q: "Can I cancel anytime?", a: "Yes! You can cancel your Gumroad subscription anytime from your Gumroad account. You'll retain access until the end of your current billing period, then demo mode continues free." },
      { q: "What email should I use for subscription?", a: "Use the same email for Gumroad payment that you enter in the Quotex Bot extension. Mismatched emails will fail verification." },
      { q: "Is my payment information secure?", a: "Yes. Payments are handled entirely by Gumroad — we never see your credit card or payment details. Gumroad uses SSL encryption and secure payment processing." },
    ]
  }
];

const schemaFaqs = faqs.flatMap(cat => cat.items).map(faq => ({
  "@type": "Question",
  "name": faq.q,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": faq.a
  }
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": schemaFaqs
};
---

<Layout
  title="Quotex Bot FAQ — Frequently Asked Questions About Quotex Auto Trading Bot"
  description="Complete FAQ for Quotex Bot Chrome Extension. Get answers about martingale strategy, compounding, take profit, stop loss, live trading subscription, mobile support and more."
  keywords="quotex faq, is quotex legit, is quotex safe, is quotex legal in india, quotex minimum deposit, quotex withdrawal, quotex withdrawal limit, quotex minimum withdrawal, quotex deposit methods, quotex registration, quotex sign up, quotex review, quotex bonus, quotex demo account, what is quotex trading platform"
  schema={schema}
>
  <Header />

  <section class="page-hero">
    <div class="container">
      <span class="badge badge-green">Help Center</span>
      <h1>Frequently Asked <span class="gradient-text">Questions</span></h1>
      <p>Find answers to the most common questions about Quotex Bot. Can't find your answer? Contact us on WhatsApp.</p>
      <a href="https://wa.me/+923064200589" target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top:20px;">
        💬 Ask on WhatsApp
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-layout">

        <!-- Sidebar nav -->
        <div class="faq-nav">
          <div class="faq-nav-title">Categories</div>
          {faqs.map((cat, i) => (
            <a href={`#cat-${i}`} class="faq-nav-link">{cat.category}</a>
          ))}
        </div>

        <!-- FAQ Content -->
        <div class="faq-content">
          {faqs.map((cat, i) => (
            <div class="faq-category" id={`cat-${i}`}>
              <h2 class="faq-category-title">{cat.category}</h2>
              <div class="faq-items">
                {cat.items.map(faq => (
                  <details class="faq-item">
                    <summary class="faq-question">
                      {faq.q}
                      <span class="faq-icon">+</span>
                    </summary>
                    <div class="faq-answer">
                      <p>{faq.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm" style="background:var(--bg2);border-top:1px solid var(--border);">
    <div class="container" style="text-align:center;">
      <h3 style="margin-bottom:12px;">Still have questions?</h3>
      <p style="color:var(--muted);margin-bottom:24px;">Our support team is available on WhatsApp. Join our trading community for tips and signals.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://wa.me/+923064200589" target="_blank" rel="noopener" class="btn btn-primary">💬 WhatsApp Support</a>
        <a href="https://chat.whatsapp.com/JCiTWuZYOQ0Ez3EVnZggVg" target="_blank" rel="noopener" class="btn btn-secondary">👥 Join Trading Group</a>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style is:global>
.page-hero { padding: 80px 0 60px; text-align: center; border-bottom: 1px solid var(--border); }
.page-hero h1 { font-size: clamp(32px, 5vw, 52px); margin: 16px 0 16px; }
.page-hero p { color: var(--muted); font-size: 17px; max-width: 560px; margin: 0 auto; }
.faq-layout { display: grid; grid-template-columns: 220px 1fr; gap: 48px; align-items: start; }
.faq-nav { position: sticky; top: 88px; }
.faq-nav-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 12px; }
.faq-nav-link { display: block; padding: 8px 12px; border-radius: 6px; font-size: 14px; color: var(--muted); transition: all 0.2s; margin-bottom: 4px; }
.faq-nav-link:hover { color: var(--text); background: var(--card); }
.faq-category { margin-bottom: 56px; }
.faq-category:last-child { margin-bottom: 0; }
.faq-category-title { font-size: 22px; font-weight: 700; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border); color: var(--accent2); }
.faq-items { display: flex; flex-direction: column; gap: 8px; }
.faq-item {
  border-radius: 10px;
  background: var(--card);
  border: 1px solid var(--border);
  overflow: hidden;
  transition: border-color 0.2s;
}
.faq-item[open] { border-color: rgba(0,230,118,0.3); }
.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  list-style: none;
  gap: 16px;
  user-select: none;
}
.faq-question::-webkit-details-marker { display: none; }
.faq-question:hover { color: var(--accent); }
.faq-icon { font-size: 20px; color: var(--muted); flex-shrink: 0; transition: transform 0.2s; }
.faq-item[open] .faq-icon { transform: rotate(45deg); color: var(--accent); }
.faq-answer { padding: 0 20px 20px; border-top: 1px solid var(--border); }
.faq-answer p { font-size: 14px; color: var(--muted); line-height: 1.8; padding-top: 16px; }
@media (max-width: 900px) {
  .faq-layout { grid-template-columns: 1fr; }
  .faq-nav { display: none; }
}
</style>
