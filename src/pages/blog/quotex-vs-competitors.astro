<style is:global>
.comp-table{border-radius:12px;overflow:hidden;border:1px solid var(--border);margin:24px 0;}
.ct-row{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr 1fr;padding:12px 16px;border-bottom:1px solid var(--border);font-size:13px;gap:8px;align-items:center;}
.ct-row:last-child{border:none;}
.ct-row.header{background:var(--bg2);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);}
.ct-row .green{color:var(--accent);font-weight:600;}
@media(max-width:768px){.ct-row{grid-template-columns:1fr 1fr;}.ct-row.header span:nth-child(n+3){display:none;}.ct-row span:nth-child(n+3){display:none;}}
