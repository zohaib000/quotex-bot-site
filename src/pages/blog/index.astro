---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: "quotex-martingale-strategy-guide",
    title: "Complete Quotex Martingale Strategy Guide 2026",
    desc: "Everything you need to know about the martingale strategy on Quotex. How it works, best sequences, risk management and how to automate it with Quotex Bot.",
    date: "June 15, 2026",
    readTime: "8 min read",
    category: "Strategy Guide",
    badge: "badge-green",
  },
  {
    slug: "how-to-use-quotex-bot",
    title: "How to Use Quotex Bot — Complete Beginner Tutorial",
    desc: "Step-by-step tutorial for setting up and using the Quotex auto trading bot Chrome extension. From installation to your first automated trade.",
    date: "June 10, 2026",
    readTime: "6 min read",
    category: "Tutorial",
    badge: "badge-blue",
  },
  {
    slug: "quotex-bot-on-mobile",
    title: "How to Use Quotex Bot on Mobile with Lemur Browser",
    desc: "Full guide to running the Quotex martingale bot on your Android mobile using Lemur Browser. Includes setup, tips and troubleshooting.",
    date: "June 5, 2026",
    readTime: "5 min read",
    category: "Mobile Guide",
    badge: "badge-blue",
  },
  {
    slug: "best-trading-sequences",
    title: "Best Quotex Martingale Sequences for 2026",
    desc: "Discover the most profitable martingale trading sequences for Quotex. Conservative, balanced and aggressive strategies with risk analysis.",
    date: "May 28, 2026",
    readTime: "7 min read",
    category: "Strategy",
    badge: "badge-green",
  },
  {
    slug: "quotex-compounding-strategy",
    title: "Quotex Compounding Strategy — Grow Your Account Faster",
    desc: "How to use the compounding feature in Quotex Bot to grow your trading account. When to enable it, risk considerations and example scenarios.",
    date: "May 20, 2026",
    readTime: "6 min read",
    category: "Strategy",
    badge: "badge-green",
  },
  {
    slug: "quotex-take-profit-stop-loss",
    title: "Setting Take Profit and Stop Loss on Quotex Bot",
    desc: "Learn how to use the automated take profit and stop loss features in Quotex Bot for better risk management and consistent trading sessions.",
    date: "May 15, 2026",
    readTime: "5 min read",
    category: "Risk Management",
    badge: "badge-blue",
  },
];
---

<Layout
  title="Quotex Bot Blog — Martingale Strategy, Trading Tips & Bot Guides"
  description="Quotex Bot blog with trading guides, martingale strategy tutorials, risk management tips and step-by-step bot setup guides. Learn how to automate your Quotex trading."
  keywords="quotex trading blog, quotex martingale guide, quotex bot tutorial, quotex trading strategy 2026, binary options martingale, quotex bot tips, qxbroker trading guide"
>
  <Header />

  <section class="page-hero">
    <div class="container">
      <span class="badge badge-green">Trading Resources</span>
      <h1>Quotex Bot <span class="gradient-text">Blog & Guides</span></h1>
      <p>Strategy guides, tutorials and tips to help you trade smarter with Quotex Bot.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map(post => (
          <article class="blog-card">
            <div class="blog-meta">
              <span class={`badge ${post.badge}`}>{post.category}</span>
              <span class="blog-date">{post.date} · {post.readTime}</span>
            </div>
            <h2 class="blog-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="blog-desc">{post.desc}</p>
            <a href={`/blog/${post.slug}`} class="blog-link">Read Article →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
.page-hero { padding: 80px 0 60px; text-align: center; border-bottom: 1px solid var(--border); }
.page-hero h1 { font-size: clamp(32px, 5vw, 52px); margin: 16px 0 16px; }
.page-hero p { color: var(--muted); font-size: 17px; max-width: 560px; margin: 0 auto; }
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.blog-card { padding: 28px; border-radius: 12px; background: var(--card); border: 1px solid var(--border); display: flex; flex-direction: column; gap: 14px; transition: border-color 0.2s; }
.blog-card:hover { border-color: rgba(0,230,118,0.3); }
.blog-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.blog-date { font-size: 12px; color: var(--muted); }
.blog-title { font-size: 18px; font-weight: 700; line-height: 1.4; }
.blog-title a { transition: color 0.2s; }
.blog-title a:hover { color: var(--accent); }
.blog-desc { font-size: 14px; color: var(--muted); line-height: 1.7; flex: 1; }
.blog-link { color: var(--accent); font-size: 14px; font-weight: 600; }
.blog-link:hover { text-decoration: underline; }
@media (max-width: 900px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
