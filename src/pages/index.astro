---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const CHROME_URL = "https://chrome.google.com/webstore/detail/dbdhnfbjkakhilkkaoemgldcikboakdf";
const GUMROAD_URL = "https://zhorizon7.gumroad.com/l/alfvjx";
const YT_PLAYLIST = "https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxx"; // replace with real playlist

const features = [
  { icon: "🤖", title: "Full Auto Trading", desc: "Set your sequence once and let the bot place trades 24/7. No manual clicking required." },
  { icon: "📊", title: "Martingale Strategy", desc: "Built-in martingale logic automatically adjusts investment after each loss to recover." },
  { icon: "📈", title: "Compounding Mode", desc: "Enable compounding to grow your position on wins instead of resetting." },
  { icon: "🎯", title: "Take Profit", desc: "Bot stops automatically when net profit reaches your target." },
  { icon: "🛑", title: "Stop Loss", desc: "Bot stops automatically when net loss reaches your limit." },
  { icon: "⏰", title: "Timer Auto Stop", desc: "Set a duration — bot runs for exactly that time then stops." },
  { icon: "🎮", title: "Free Demo Mode", desc: "Try the full bot on Quotex demo account completely free." },
  { icon: "⭐", title: "Custom Presets", desc: "Save your own trading strategies. Apply with one click." },
];

const reviews = [
  { name: "Santhosh K.", country: "India", flag: "🇮🇳", avatar: "SK", color: "#0070f3", rating: 5, text: "Best Quotex bot I've ever used! The martingale strategy works perfectly and take profit saved me from overtrading. Running on demo first was a great idea." },
  { name: "Sandy S.", country: "USA", flag: "🇺🇸", avatar: "SS", color: "#00a651", rating: 5, text: "I was skeptical but this bot genuinely works. Compounding mode combined with stop loss made my sessions very controlled. Worth every penny for live." },
  { name: "Subhash N.", country: "India", flag: "🇮🇳", avatar: "SN", color: "#7c3aed", rating: 5, text: "Trade detection is super fast. No delays between trades at all. WhatsApp support is also very responsive. Highly recommend!" },
  { name: "Asif S.", country: "Pakistan", flag: "🇵🇰", avatar: "AS", color: "#059669", rating: 5, text: "I use it on mobile with Lemur browser. Works perfectly! The session stats showing profit, loss and net in real time is a fantastic feature." },
  { name: "Jensen B.", country: "USA", flag: "🇺🇸", avatar: "JB", color: "#dc2626", rating: 4, text: "Great extension. The preset strategies save a lot of time. I use the Balanced preset mainly and results have been consistent over weeks." },
  { name: "Bilas P.", country: "India", flag: "🇮🇳", avatar: "BP", color: "#d97706", rating: 5, text: "Amazing tool! Random pause between trades makes it look natural. The Chrome sidebar is so convenient compared to other bots I've tried." },
];
---

<Layout
  title="Quotex Bot — Free Quotex Martingale Trading Bot Chrome Extension 2026"
  description="Free Quotex Martingale Trading Bot Chrome Extension. Automate binary options trading on QXBroker with martingale strategy, take profit, stop loss, compounding and live session stats. Free on demo, $20/month live."
  keywords="quotex bot, quotex trading bot, quotex martingale bot, quotex auto trading, quotex chrome extension, qxbroker bot, binary options bot, quotex martingale strategy 2026, quotex bot free download, binary trading bot chrome"
>
  <Header />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <div class="hero-badges">
            <span class="badge badge-green">✅ 100% Free on Demo</span>
            <span class="badge badge-blue">🆕 v1.3 — 2026</span>
          </div>
          <h1>The Smartest<br/><span class="gradient-text">Quotex Trading Bot</span><br/>Chrome Extension</h1>
          <p class="hero-desc">Automate your <strong>Quotex martingale trading strategy</strong> with the most advanced free Chrome extension for QXBroker. Smart take profit, stop loss, compounding and real-time stats.</p>
          <div class="hero-btns">
            <a href={CHROME_URL} target="_blank" rel="noopener" class="btn btn-primary btn-hero">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="currentColor"/><line x1="12" y1="2" x2="12" y2="8" stroke="currentColor" stroke-width="1.5"/><line x1="20.66" y1="17" x2="14.68" y2="14" stroke="currentColor" stroke-width="1.5"/><line x1="3.34" y1="17" x2="9.32" y2="14" stroke="currentColor" stroke-width="1.5"/></svg>
              Add to Chrome — Free
            </a>
            <a href="/how-it-works" class="btn btn-secondary">▶ Watch Tutorial</a>
          </div>
          <p class="hero-note">⚡ Free on Demo · No credit card needed · Live Trading $20/mo</p>
        </div>
        <div class="hero-right">
          <div class="bot-card">
            <div class="bc-header">
              <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
              <span>🤖 Quotex Bot Sidebar</span>
            </div>
            <div class="bc-stats">
              <div class="bcs green">📈 Profit: +$47.20</div>
              <div class="bcs red">📉 Loss: -$12.00</div>
              <div class="bcs blue">💰 Net: +$35.20</div>
              <div class="bcs">🔄 Trades: 18</div>
            </div>
            <div class="bc-active">▶ Active — UP — $4</div>
            <div class="bc-seq">
              <p class="seq-l">SEQUENCE</p>
              <div class="seq-s"><span class="ss done">$1✓</span><span class="ss done">$2✓</span><span class="ss curr">$4→</span><span class="ss">$8</span></div>
            </div>
            <div class="bc-ctrls">
              <div class="bcc g">✅ Take Profit: $50</div>
              <div class="bcc r">🛑 Stop Loss: $20</div>
              <div class="bcc b">⏰ Timer: 25:00</div>
            </div>
            <div class="bc-pulse"><span class="pd"></span><span>Bot placing trade...</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING CTA STRIP just below hero -->
  <div class="price-strip">
    <div class="container">
      <div class="ps-inner">
        <div class="ps-left">
          <span class="ps-free">🎮 Demo — <strong>FREE</strong></span>
          <span class="ps-sep">|</span>
          <span class="ps-live">💰 Live Trading — <strong>$20/month</strong></span>
        </div>
        <div class="ps-right">
          <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn btn-outline">Get Live Access →</a>
          <a href="/pricing" class="btn btn-secondary" style="font-size:13px;">Compare Plans</a>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS -->
  <div class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div class="si"><div class="sv">10,000+</div><div class="sl">Active Users</div></div>
        <div class="si"><div class="sv">FREE</div><div class="sl">Demo Mode</div></div>
        <div class="si"><div class="sv">4.8★</div><div class="sl">Chrome Rating</div></div>
        <div class="si"><div class="sv">$20/mo</div><div class="sl">Live Trading</div></div>
      </div>
    </div>
  </div>

  <!-- ABOUT -->
  <section class="section">
    <div class="container">
      <div class="two-col">
        <div class="tc-text">
          <span class="badge badge-green">What is Quotex Bot?</span>
          <h2>Automate Your <span class="gradient-text">Quotex Trading</span> in Minutes</h2>
          <p>Quotex Bot is a powerful <strong>Chrome extension for QXBroker / Quotex</strong> that fully automates your binary options trading using the proven <strong>martingale strategy</strong>. Set your sequence, click Start, and let the bot do the rest.</p>
          <p>Runs directly in your browser as a <strong>Chrome sidebar</strong> — no downloads, no VPS, no complicated setup. Works on demo completely free.</p>
          <ul class="tick-list">
            <li>✅ Works on demo account — 100% free</li>
            <li>✅ Live trading with $20/month subscription</li>
            <li>✅ No installation beyond Chrome extension</li>
            <li>✅ Compatible with all Quotex / QXBroker trading pairs</li>
            <li>✅ Supports USD, EUR, GBP, INR, PKR and all currencies</li>
          </ul>
        </div>
        <div class="tc-cards">
          <div class="mc"><div class="mc-i">🎮</div><h3>Demo Mode</h3><p>Practice with virtual money. Full features free on Quotex demo.</p></div>
          <div class="mc hl"><div class="mc-i">💰</div><h3>Live Trading</h3><p>Real account trading. Verified via Gumroad subscription.</p></div>
          <div class="mc"><div class="mc-i">📱</div><h3>Mobile Support</h3><p>Works on Android with Lemur Browser.</p></div>
          <div class="mc"><div class="mc-i">🌍</div><h3>All Currencies</h3><p>USD, EUR, GBP, INR, PKR and all Quotex pairs.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO BUY / GET STARTED -->
  <section class="section bg2" id="get-started">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-gold">How to Get Started</span>
        <h2>3 Simple Steps to <span class="gradient-text">Start Auto Trading</span></h2>
        <p>From zero to automated trading in under 5 minutes. Free to try on demo — no credit card required.</p>
      </div>
      <div class="gs-grid">
        <div class="gs-card">
          <div class="gs-num">01</div>
          <div class="gs-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#00a651" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="#00a651"/><line x1="12" y1="2" x2="12" y2="8" stroke="#00a651" stroke-width="1.5"/><line x1="20.66" y1="17" x2="14.68" y2="14" stroke="#00a651" stroke-width="1.5"/><line x1="3.34" y1="17" x2="9.32" y2="14" stroke="#00a651" stroke-width="1.5"/></svg>
          </div>
          <h3>Install Chrome Extension</h3>
          <p>Add Quotex Bot from the Chrome Web Store with one click. Completely free — no account required for demo mode.</p>
          <a href={CHROME_URL} target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:16px;width:100%;justify-content:center;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="currentColor"/><line x1="12" y1="2" x2="12" y2="8" stroke="currentColor" stroke-width="1.5"/><line x1="20.66" y1="17" x2="14.68" y2="14" stroke="currentColor" stroke-width="1.5"/><line x1="3.34" y1="17" x2="9.32" y2="14" stroke="currentColor" stroke-width="1.5"/></svg>
            Add to Chrome — Free
          </a>
          <div class="gs-note">✅ Works on demo immediately after install</div>
        </div>

        <div class="gs-card">
          <div class="gs-num">02</div>
          <div class="gs-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="#0070f3" stroke-width="1.5"/><path d="M8 21h8M12 17v4" stroke="#0070f3" stroke-width="1.5"/><circle cx="17" cy="8" r="3" fill="#0070f3" opacity=".3"/><path d="M15.5 8l1 1 2-2" stroke="#0070f3" stroke-width="1.2"/></svg>
          </div>
          <h3>Buy Live Trading Access</h3>
          <p>Want to trade with real money? Get the $20/month subscription via Gumroad. Use the same email in the extension to verify instantly.</p>
          <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:16px;width:100%;justify-content:center;background:#0070f3;">
            💳 Buy on Gumroad — $20/mo
          </a>
          <div class="gs-note">🎮 Or skip this — demo is fully free forever</div>
        </div>

        <div class="gs-card">
          <div class="gs-num">03</div>
          <div class="gs-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="#f59e0b" stroke-width="1.5" fill="rgba(245,158,11,0.1)"/></svg>
          </div>
          <h3>Start Auto Trading</h3>
          <p>Open Quotex demo or live page. Open the sidebar, pick a preset strategy, configure your risk limits and click Start Trading!</p>
          <a href="/how-it-works" class="btn btn-outline" style="margin-top:16px;width:100%;justify-content:center;">
            📖 View Full Guide
          </a>
          <div class="gs-note">⚡ First trade executes in under 30 seconds</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-blue">All Features</span>
        <h2>Everything You Need for <span class="gradient-text">Automated Trading</span></h2>
        <p>Professional trading features — completely free on demo, premium for live trading.</p>
      </div>
      <div class="feat-grid">
        {features.map(f => (
          <div class="feat-card">
            <div class="fi">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
      <div class="center-btn"><a href="/features" class="btn btn-secondary">See All Features →</a></div>
    </div>
  </section>

  <!-- PRESETS -->
  <section class="section bg2">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-green">Strategy Presets</span>
        <h2>4 Built-in <span class="gradient-text">Martingale Presets</span></h2>
        <p>Choose from ready-made presets or create your own custom strategy.</p>
      </div>
      <div class="presets-grid">
        <div class="pc" style="border-color:#00a65133"><div class="pr" style="color:#00a651;background:#00a65118">Low Risk</div><h3 style="color:#00a651">Conservative</h3><p>Best for beginners. Small amounts, short sequence.</p><div class="pa"><span>Amounts:</span><code>1 → 2 → 4 → 8</code></div></div>
        <div class="pc" style="border-color:#0070f333"><div class="pr" style="color:#0070f3;background:#0070f318">Medium Risk</div><h3 style="color:#0070f3">Balanced</h3><p>Most popular. 8-step double-up martingale.</p><div class="pa"><span>Amounts:</span><code>1 → 2 → 4 → 8 → 17 → 35 → 73 → 151</code></div></div>
        <div class="pc" style="border-color:#f59e0b33"><div class="pr" style="color:#f59e0b;background:#f59e0b18">High Risk</div><h3 style="color:#f59e0b">Aggressive</h3><p>Triple-up martingale. Requires larger account.</p><div class="pa"><span>Amounts:</span><code>1 → 3 → 9 → 27 → 81 → 243...</code></div></div>
        <div class="pc" style="border-color:#ef444433"><div class="pr" style="color:#ef4444;background:#ef444418">Very High Risk</div><h3 style="color:#ef4444">Turbo</h3><p>Extreme compounding for large accounts only.</p><div class="pa"><span>Amounts:</span><code>1 → 5 → 25 → 125 → 625...</code></div></div>
      </div>
    </div>
  </section>

  <!-- YOUTUBE VIDEOS -->
  <section class="section">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-blue">📺 Video Tutorials</span>
        <h2>Learn Quotex Bot in <span class="gradient-text">Video Tutorials</span></h2>
        <p>Watch our complete playlist covering everything from installation to advanced strategies. Free on YouTube.</p>
      </div>
      <div class="yt-grid">
        <!-- Replace these YouTube IDs with your real video IDs -->
        <div class="yt-card">
          <div class="yt-thumb">
            <iframe src="https://www.youtube.com/embed/videoseries?list=PLxxxxxxxxxxxxxxx" title="Quotex Bot Complete Tutorial Playlist" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="yt-info">
            <span class="badge badge-blue">Full Playlist</span>
            <h3>Quotex Bot — Complete Tutorial Series</h3>
            <p>Installation, configuration, strategy setup, live trading demo and advanced tips. Everything in one playlist.</p>
            <a href={YT_PLAYLIST} target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top:12px;">
              ▶ Watch Full Playlist
            </a>
          </div>
        </div>
        <div class="yt-side">
          {[
            { title: "How to Install Quotex Bot", desc: "Step-by-step installation guide", id: "dQw4w9WgXcQ" },
            { title: "Martingale Strategy Explained", desc: "Complete martingale tutorial", id: "dQw4w9WgXcQ" },
            { title: "Compounding Mode Guide", desc: "How to grow your account faster", id: "dQw4w9WgXcQ" },
            { title: "Live Trading Demo", desc: "Real account trading session", id: "dQw4w9WgXcQ" },
          ].map(v => (
            <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener" class="yt-mini">
              <div class="yt-mini-thumb">
                <img src={`https://img.youtube.com/vi/${v.id}/mqdefault.jpg`} alt={v.title} loading="lazy"/>
                <div class="yt-play">▶</div>
              </div>
              <div class="yt-mini-info">
                <strong>{v.title}</strong>
                <span>{v.desc}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS WITH AVATARS -->
  <section class="section bg2">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-green">Real Users</span>
        <h2>What Traders Say About <span class="gradient-text">Quotex Bot</span></h2>
      </div>
      <div class="reviews-grid">
        {reviews.map(r => (
          <div class="rv-card">
            <div class="rv-top">
              <div class="rv-avatar" style={`background:${r.color}`}>{r.avatar}</div>
              <div class="rv-info">
                <div class="rv-name">{r.name} <span class="rv-flag">{r.flag}</span></div>
                <div class="rv-country">{r.country}</div>
              </div>
              <div class="rv-stars">{"⭐".repeat(r.rating)}</div>
            </div>
            <p>"{r.text}"</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-sec">
    <div class="container">
      <div class="cta-inner">
        <p class="cta-eye">🚀 Ready to Automate?</p>
        <h2>Start Trading Automatically<br/><span class="gradient-text">100% Free on Demo</span></h2>
        <p>Join thousands of traders automating their Quotex martingale strategy. No credit card needed for demo.</p>
        <div class="cta-btns">
          <a href={CHROME_URL} target="_blank" rel="noopener" class="btn btn-primary btn-hero">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="currentColor"/><line x1="12" y1="2" x2="12" y2="8" stroke="currentColor" stroke-width="1.5"/><line x1="20.66" y1="17" x2="14.68" y2="14" stroke="currentColor" stroke-width="1.5"/><line x1="3.34" y1="17" x2="9.32" y2="14" stroke="currentColor" stroke-width="1.5"/></svg>
            Add to Chrome — Free
          </a>
          <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn btn-outline">💰 Get Live Access — $20/mo</a>
        </div>
        <div class="cta-links">
          <a href="https://wa.me/+923064200589" target="_blank" rel="noopener">💬 WhatsApp Support</a>
          <a href="https://chat.whatsapp.com/JCiTWuZYOQ0Ez3EVnZggVg" target="_blank" rel="noopener">👥 Join Community</a>
          <a href="/faq">❓ FAQ</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style is:global>
/* HERO */
.hero{position:relative;padding:96px 0 72px;overflow:hidden;}
.hero-bg{position:absolute;inset:0;pointer-events:none;background:linear-gradient(135deg,rgba(0,166,81,0.04) 0%,rgba(0,112,243,0.04) 100%);}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
.hero-badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;}
.hero-left h1{font-size:clamp(30px,4.5vw,52px);font-weight:800;line-height:1.1;margin-bottom:20px;color:var(--text);}
.hero-desc{font-size:16px;color:var(--muted);line-height:1.8;margin-bottom:28px;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;}
.btn-hero{font-size:15px!important;padding:14px 26px!important;}
.hero-note{font-size:13px;color:var(--muted);}

/* BOT CARD */
.bot-card{background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px;font-size:13px;box-shadow:var(--shadow-lg);}
.bc-header{display:flex;align-items:center;gap:6px;padding-bottom:12px;border-bottom:1px solid var(--border);margin-bottom:12px;font-size:12px;color:var(--muted);}
.dot{width:10px;height:10px;border-radius:50%;}
.dot.r{background:#ff5f57;}.dot.y{background:#febc2e;}.dot.g{background:#28c840;}
.bc-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.bcs{padding:8px 10px;border-radius:8px;font-size:12px;font-weight:600;background:var(--bg2);border:1px solid var(--border);color:var(--muted);}
.bcs.green{background:rgba(0,166,81,0.08);border-color:rgba(0,166,81,0.2);color:var(--accent);}
.bcs.red{background:rgba(239,68,68,0.08);border-color:rgba(239,68,68,0.2);color:var(--red);}
.bcs.blue{background:rgba(0,112,243,0.08);border-color:rgba(0,112,243,0.2);color:var(--accent2);}
.bc-active{padding:10px 14px;border-radius:8px;font-weight:700;font-size:13px;background:rgba(0,166,81,0.08);color:var(--accent);border:1px solid rgba(0,166,81,0.2);margin-bottom:10px;}
.bc-seq{margin-bottom:10px;}
.seq-l{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;}
.seq-s{display:flex;gap:8px;}
.ss{padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;background:var(--bg2);border:1px solid var(--border);color:var(--muted);}
.ss.done{background:rgba(0,166,81,0.08);border-color:rgba(0,166,81,0.3);color:var(--accent);}
.ss.curr{background:rgba(0,112,243,0.1);border-color:rgba(0,112,243,0.3);color:var(--accent2);}
.bc-ctrls{display:flex;flex-direction:column;gap:6px;margin-bottom:10px;}
.bcc{padding:7px 12px;border-radius:6px;font-size:12px;background:var(--bg2);border:1px solid var(--border);color:var(--muted);}
.bcc.g{border-color:rgba(0,166,81,0.2);color:var(--accent);}
.bcc.r{border-color:rgba(239,68,68,0.2);color:var(--red);}
