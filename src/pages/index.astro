---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ChromeIcon from '../components/ChromeIcon.astro';

const CHROME_URL = "https://chrome.google.com/webstore/detail/dbdhnfbjkakhilkkaoemgldcikboakdf";
const GUMROAD_URL = "https://zhorizon7.gumroad.com/l/alfvjx";
const YT_PLAYLIST = "https://www.youtube.com/playlist?list=PL-DfyZg6D8FkGX8t4j_NyGqKCGUIl9sAW";

const videos = [
  { id: "fifxxfVrXjU", title: "Quotex Bot — Complete Tutorial 2026", desc: "Full setup guide from installation to first automated trade" },
  { id: "juJEJd_no44", title: "Martingale Strategy Explained", desc: "How martingale works and best sequences" },
  { id: "OzfBVqXIFJY", title: "Live Trading Demo", desc: "Real account trading session with Quotex Bot" },
  { id: "KC54Y0TfEWI", title: "Mobile Trading on Lemur Browser", desc: "How to use Quotex Bot on Android mobile" },
  { id: "dTmgnq5DyEQ", title: "Compounding Mode Guide", desc: "Grow your account faster with compounding" },
  { id: "o-qC-uFmpV4", title: "Take Profit & Stop Loss Setup", desc: "Risk management for consistent trading" },
  { id: "4aRa7tu259Q", title: "Custom Presets & Sequences", desc: "Create and save your own trading strategies" },
  { id: "9UaGMjOMjkw", title: "Quotex Bot Promo — Full Overview", desc: "Everything about Quotex Bot in one video" },
];

const mainVideo = videos[7]; // promo video

const features = [
  { icon: "🤖", title: "Full Auto Trading", desc: "Set your sequence once and let the bot place trades 24/7. No manual clicking required." },
  { icon: "📊", title: "Martingale Strategy", desc: "Built-in martingale logic automatically adjusts investment after each loss to recover." },
  { icon: "📈", title: "Compounding Mode", desc: "Enable compounding to grow your position on wins instead of resetting." },
  { icon: "🎯", title: "Take Profit", desc: "Bot stops automatically when net profit reaches your target amount." },
  { icon: "🛑", title: "Stop Loss", desc: "Bot stops automatically when net loss reaches your set limit." },
  { icon: "⏰", title: "Timer Auto Stop", desc: "Set a duration — bot runs for exactly that time then stops." },
  { icon: "🎮", title: "Free Demo Mode", desc: "Try the full bot on Quotex demo account completely free forever." },
  { icon: "⭐", title: "Custom Presets", desc: "Save your own trading strategies. Apply with one click anytime." },
];

const reviews = [
  { name: "Santhosh K.", country: "India", flag: "🇮🇳", avatar: "SK", color: "#0070f3", rating: 5, text: "Best Quotex bot I've ever used! The martingale strategy works perfectly and take profit saved me from overtrading. Running on demo first was a great idea." },
  { name: "Sandy S.", country: "USA", flag: "🇺🇸", avatar: "SS", color: "#00a651", rating: 5, text: "I was skeptical but this bot genuinely works. Compounding mode combined with stop loss made my sessions very controlled. Worth every penny for live." },
  { name: "Subhash N.", country: "India", flag: "🇮🇳", avatar: "SN", color: "#7c3aed", rating: 5, text: "Trade detection is super fast. No delays between trades at all. WhatsApp support is also very responsive. Highly recommend!" },
  { name: "Asif S.", country: "Pakistan", flag: "🇵🇰", avatar: "AS", color: "#059669", rating: 5, text: "I use it on mobile with Lemur browser. Works perfectly! The session stats showing profit, loss and net in real time is fantastic." },
  { name: "Jensen B.", country: "USA", flag: "🇺🇸", avatar: "JB", color: "#dc2626", rating: 4, text: "Great extension. The preset strategies save a lot of time. Balanced preset has given me consistent results over weeks of trading." },
  { name: "Bilas P.", country: "India", flag: "🇮🇳", avatar: "BP", color: "#d97706", rating: 5, text: "Amazing tool! Random pause between trades makes it look natural. The Chrome sidebar is so convenient compared to other bots." },
];
---

<Layout
  title="Quotex Bot — Free Quotex Martingale Trading Bot Chrome Extension 2026"
  description="Free Quotex Martingale Trading Bot Chrome Extension. Automate binary options trading on QXBroker with martingale strategy, take profit, stop loss, compounding and live session stats. Free on demo, $20/month live."
  keywords="quotex bot, quotex trading bot, quotex trading, quotex trade, quotex demo, quotex app, quotex review, quotex trading strategy, what is quotex, quotex trading platform, quotex martingale bot, quotex auto trading, quotex chrome extension, qxbroker bot, binary options bot, quotex bot free, quotex signal generator, quotex tips, quotex trading guide, is quotex legit, is quotex safe, quotex demo account"
>
  <Header />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <div class="hero-badges">
            <span class="badge badge-green">✅ 100% Free on Demo</span>
            <span class="badge badge-blue">🆕 v1.3 — 2026</span>
          </div>
          <h1>The Smartest<br/><span class="gradient-text">Quotex Trading Bot</span><br/>Chrome Extension</h1>
          <p class="hero-desc">Automate your <strong>Quotex martingale trading strategy</strong> with the most advanced free Chrome extension for QXBroker. Smart take profit, stop loss, compounding and real-time stats — all in one sidebar.</p>
          <div class="hero-btns">
            <a href={CHROME_URL} target="_blank" rel="noopener" class="btn btn-primary btn-hero">
              <img src="https://cdn-icons-png.flaticon.com/512/732/732205.png" width="20" height="20" alt="Chrome" style="flex-shrink:0;display:inline-block;vertical-align:middle;"/>
              Add to Chrome — Free
            </a>
            <a href="/how-it-works" class="btn btn-secondary">▶ Watch Tutorial</a>
          </div>
          <p class="hero-note">⚡ Free on Demo · No credit card needed · Live Trading $20/mo</p>
        </div>
        <div class="hero-right">
          <div class="bot-card">
            <div class="bc-hdr">
              <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
              <span class="bc-title">🤖 Quotex Bot Sidebar</span>
            </div>
            <div class="bc-stats">
              <div class="bcs green">📈 Profit: +$47.20</div>
              <div class="bcs red">📉 Loss: -$12.00</div>
              <div class="bcs blue">💰 Net: +$35.20</div>
              <div class="bcs">🔄 Trades: 18</div>
            </div>
            <div class="bc-active">▶ Active — UP — $4</div>
            <div class="bc-seq">
              <p class="seq-lbl">SEQUENCE</p>
              <div class="seq-row"><span class="ss done">$1✓</span><span class="ss done">$2✓</span><span class="ss curr">$4→</span><span class="ss">$8</span></div>
            </div>
            <div class="bc-ctrls">
              <div class="bcc g">✅ Take Profit: $50</div>
              <div class="bcc r">🛑 Stop Loss: $20</div>
              <div class="bcc b">⏰ Timer: 25:00</div>
            </div>
            <div class="bc-pulse"><span class="pd"></span><span>Bot placing trade...</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING STRIP -->
  <div class="price-strip">
    <div class="container">
      <div class="ps-inner">
        <div class="ps-left">
          <span>🎮 Demo — <strong>FREE</strong></span>
          <span class="ps-div">|</span>
          <span>💰 Live Trading — <strong>$20/month</strong></span>
        </div>
        <div class="ps-right">
          <a href={GUMROAD_URL} target="_blank" rel="noopener" class="ps-btn-main">Get Live Access →</a>
          <a href="/pricing" class="ps-btn-sec">Compare Plans</a>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS -->
  <div class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div class="si"><div class="sv">10,000+</div><div class="sl">Active Users</div></div>
        <div class="si"><div class="sv">FREE</div><div class="sl">Demo Mode</div></div>
        <div class="si"><div class="sv">4.8★</div><div class="sl">Chrome Rating</div></div>
        <div class="si"><div class="sv">$20/mo</div><div class="sl">Live Trading</div></div>
      </div>
    </div>
  </div>

  <!-- ABOUT / QUOTEX BRANDING -->
  <section class="section">
    <div class="container">
      <div class="two-col">
        <div class="tc-text">
          <span class="badge badge-green">What is Quotex Bot?</span>
          <h2>Automate Your <span class="gradient-text">Quotex Trading</span> in Minutes</h2>
          <p>Quotex Bot is a powerful <strong>Chrome extension for QXBroker / Quotex</strong> that fully automates your binary options trading using the proven <strong>martingale strategy</strong>. Set your sequence, click Start, and let the bot do the rest.</p>
          <p>Runs directly in your browser as a <strong>Chrome sidebar extension</strong> — no downloads, no VPS, no complicated setup. Free on demo forever.</p>
          <ul class="tick-list">
            <li>✅ Works on demo account — 100% free</li>
            <li>✅ Live trading with $20/month subscription</li>
            <li>✅ No installation beyond Chrome extension</li>
            <li>✅ Compatible with all Quotex / QXBroker trading pairs</li>
            <li>✅ Supports USD, EUR, GBP, INR, PKR and all currencies</li>
          </ul>

          <!-- QUOTEX BRANDING BADGE -->
          <div class="quotex-badge">
            <div class="qb-logo">
              <svg width="28" height="28" viewBox="0 0 100 100"><defs><linearGradient id="qg2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#00c951"/><stop offset="100%" style="stop-color:#0088cc"/></linearGradient></defs><rect width="100" height="100" rx="20" fill="url(#qg2)"/><text x="50" y="68" font-size="54" text-anchor="middle" font-family="Arial" fill="white" font-weight="bold">Q</text></svg>
              <span><strong>Official Partner</strong><br/>Works with Quotex / QXBroker</span>
            </div>
            <a href="https://qxbroker.com" target="_blank" rel="noopener" class="qb-link">Open Quotex →</a>
          </div>
        </div>
        <div class="tc-cards">
          <div class="mc"><div class="mc-i">🎮</div><h3>Demo Mode</h3><p>Practice with virtual money. Full features free on Quotex demo.</p></div>
          <div class="mc hl"><div class="mc-i">💰</div><h3>Live Trading</h3><p>Real account trading. Verified via Gumroad subscription.</p></div>
          <div class="mc"><div class="mc-i">📱</div><h3>Mobile Support</h3><p>Works on Android with Lemur Browser.</p></div>
          <div class="mc"><div class="mc-i">🌍</div><h3>All Currencies</h3><p>USD, EUR, GBP, INR, PKR and all Quotex pairs.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO GET STARTED — animated gradient border cards -->
  <section class="section" id="get-started" style="background:var(--bg2);">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-gold">How to Get Started</span>
        <h2>3 Simple Steps to <span class="gradient-text">Start Auto Trading</span></h2>
        <p>From zero to automated trading in under 5 minutes. Free to try on demo — no credit card required.</p>
      </div>
      <div class="gs-grid">

        <!-- Card 1 -->
        <div class="agb-wrap" style="--c1:#00a651;--c2:#0070f3;--c3:#00a651;">
          <div class="agb-inner">
            <div class="gs-num">01</div>
            <div class="gs-ico">
              <img src="https://cdn-icons-png.flaticon.com/512/732/732205.png" width="44" height="44" alt="Chrome" style="flex-shrink:0;display:block;"/>
            </div>
            <div class="gs-step-badge">Step 1</div>
            <h3>Install Chrome Extension</h3>
            <p>Add Quotex Bot from the Chrome Web Store. Completely free — no account or credit card required for demo mode.</p>
            <a href={CHROME_URL} target="_blank" rel="noopener" class="btn btn-primary gs-btn">
              <svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="rgba(255,255,255,0.3)"/><circle cx="12" cy="12" r="5" fill="white" opacity=".5"/><path d="M12 3H21" stroke="white" stroke-width="2.5" stroke-linecap="round"/><path d="M12 3L7.3 11" stroke="white" stroke-width="2.5" stroke-linecap="round"/><path d="M16.7 11L7.3 11" stroke="white" stroke-width="2.5" stroke-linecap="round"/><circle cx="12" cy="12" r="3" fill="white"/></svg>
              Add to Chrome — Free
            </a>
            <div class="gs-note">✅ Works on demo immediately after install</div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="agb-wrap" style="--c1:#0070f3;--c2:#7c3aed;--c3:#0070f3;">
          <div class="agb-inner">
            <div class="gs-num">02</div>
            <div class="gs-ico">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="3" width="20" height="14" rx="3" fill="#eff6ff" stroke="#0070f3" stroke-width="1.5"/>
                <path d="M8 21h8M12 17v4" stroke="#0070f3" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="16" cy="8.5" r="3" fill="#0070f3" opacity=".15" stroke="#0070f3" stroke-width="1.2"/>
                <path d="M14.8 8.6l1 1 1.8-1.8" stroke="#0070f3" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="gs-step-badge" style="background:rgba(0,112,243,0.1);color:#0070f3;border-color:rgba(0,112,243,0.2);">Step 2 — Optional</div>
            <h3>Buy Live Trading Access</h3>
            <p>For real money trading, get $20/month subscription on Gumroad. Use the same email in the extension to verify. <strong>Demo is free forever — skip this if just starting!</strong></p>
            <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn btn-blue gs-btn">
              💳 Buy on Gumroad — $20/mo
            </a>
            <div class="gs-note" style="background:rgba(0,112,243,0.06);color:#1e40af;">🎮 Skip this — demo is fully free, no time limit</div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="agb-wrap" style="--c1:#f59e0b;--c2:#00a651;--c3:#f59e0b;">
          <div class="agb-inner">
            <div class="gs-num">03</div>
            <div class="gs-ico">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="rgba(245,158,11,0.15)" stroke="#f59e0b" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="gs-step-badge" style="background:rgba(245,158,11,0.1);color:#92400e;border-color:rgba(245,158,11,0.25);">Step 3</div>
            <h3>Start Auto Trading</h3>
            <p>Open Quotex demo or live page, open the sidebar, pick a preset strategy, set your risk limits and click Start Trading!</p>
            <a href="/how-it-works" class="btn btn-outline gs-btn">📖 View Full Guide</a>
            <div class="gs-note" style="background:rgba(245,158,11,0.07);color:#92400e;">⚡ First trade executes in under 30 seconds</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-blue">All Features</span>
        <h2>Everything You Need for <span class="gradient-text">Automated Trading</span></h2>
        <p>Professional trading features — completely free on demo, premium for live trading.</p>
      </div>
      <div class="feat-grid">
        {features.map(f => (
          <div class="feat-card">
            <div class="fi">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
      <div class="center-btn"><a href="/features" class="btn btn-secondary">See All Features →</a></div>
    </div>
  </section>

  <!-- PRESETS -->
  <section class="section bg2">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-green">Strategy Presets</span>
        <h2>4 Built-in <span class="gradient-text">Martingale Presets</span></h2>
        <p>Choose from ready-made presets or create your own custom martingale strategy.</p>
      </div>
      <div class="presets-grid">
        <div class="pc" style="border-color:#00a65133"><div class="pr" style="color:#00a651;background:#00a65112">Low Risk</div><h3 style="color:#00a651">Conservative</h3><p>Best for beginners. Small amounts, short sequence.</p><div class="pa"><span>Amounts:</span><code>1 → 2 → 4 → 8</code></div></div>
        <div class="pc" style="border-color:#0070f333"><div class="pr" style="color:#0070f3;background:#0070f312">Medium Risk</div><h3 style="color:#0070f3">Balanced</h3><p>Most popular. 8-step double-up martingale.</p><div class="pa"><span>Amounts:</span><code>1 → 2 → 4 → 8 → 17 → 35 → 73 → 151</code></div></div>
        <div class="pc" style="border-color:#f59e0b33"><div class="pr" style="color:#b45309;background:#f59e0b12">High Risk</div><h3 style="color:#b45309">Aggressive</h3><p>Triple-up martingale. Requires larger account.</p><div class="pa"><span>Amounts:</span><code>1 → 3 → 9 → 27 → 81 → 243...</code></div></div>
        <div class="pc" style="border-color:#ef444433"><div class="pr" style="color:#ef4444;background:#ef444412">Very High Risk</div><h3 style="color:#ef4444">Turbo</h3><p>Extreme compounding for large accounts only.</p><div class="pa"><span>Amounts:</span><code>1 → 5 → 25 → 125 → 625...</code></div></div>
      </div>
    </div>
  </section>

  <!-- YOUTUBE VIDEOS -->
  <section class="section">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-blue">📺 Video Tutorials</span>
        <h2>Learn Quotex Bot on <span class="gradient-text">YouTube</span></h2>
        <p>Watch our complete tutorial playlist — from installation to advanced strategies. Everything free on YouTube.</p>
      </div>
      <div class="yt-layout">
        <div class="yt-main-card">
          <div class="yt-embed">
            <iframe
              src={`https://www.youtube.com/embed/${mainVideo.id}?list=PL-DfyZg6D8FkGX8t4j_NyGqKCGUIl9sAW`}
              title={mainVideo.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <div class="yt-main-info">
            <span class="badge badge-blue">🎬 Featured Video</span>
            <h3>{mainVideo.title}</h3>
            <p>{mainVideo.desc}</p>
            <a href={YT_PLAYLIST} target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top:14px;">
              📺 Watch Full Playlist ({videos.length} Videos)
            </a>
          </div>
        </div>
        <div class="yt-list">
          {videos.slice(0, 7).map(v => (
            <a href={`https://www.youtube.com/watch?v=${v.id}&list=PL-DfyZg6D8FkGX8t4j_NyGqKCGUIl9sAW`} target="_blank" rel="noopener" class="yt-item">
              <div class="yt-thumb-wrap">
                <img src={`https://img.youtube.com/vi/${v.id}/mqdefault.jpg`} alt={v.title} loading="lazy" width="120" height="68"/>
                <div class="yt-play-btn">▶</div>
              </div>
              <div class="yt-item-info">
                <strong>{v.title}</strong>
                <span>{v.desc}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS WITH AVATARS -->
  <section class="section bg2">
    <div class="container">
      <div class="sec-hd">
        <span class="badge badge-green">⭐ Real Users</span>
        <h2>What Traders Say About <span class="gradient-text">Quotex Bot</span></h2>
      </div>
      <div class="reviews-grid">
        {reviews.map(r => (
          <div class="rv-card">
            <div class="rv-top">
              <div class="rv-av" style={`background:${r.color}`}>{r.avatar}</div>
              <div class="rv-meta">
                <div class="rv-name">{r.name} <span>{r.flag}</span></div>
                <div class="rv-loc">{r.country}</div>
              </div>
              <div class="rv-stars">{"⭐".repeat(r.rating)}</div>
            </div>
            <p>"{r.text}"</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-sec">
    <div class="container">
      <div class="cta-inner">
        <p class="cta-eye">🚀 Ready to Automate Your Trading?</p>
        <h2>Start Trading Automatically<br/><span class="gradient-text">100% Free on Demo</span></h2>
        <p>Join thousands of traders automating their Quotex martingale strategy. No credit card needed for demo mode.</p>
        <div class="cta-btns">
          <a href={CHROME_URL} target="_blank" rel="noopener" class="btn btn-primary btn-hero">
            <img src="https://cdn-icons-png.flaticon.com/512/732/732205.png" width="20" height="20" alt="Chrome" style="flex-shrink:0;display:inline-block;vertical-align:middle;"/>
            Add to Chrome — Free
          </a>
          <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn btn-outline">💰 Get Live Access — $20/mo</a>
        </div>
        <div class="cta-links">
          <a href="https://wa.me/+923064200589" target="_blank" rel="noopener">💬 WhatsApp Support</a>
          <a href="https://chat.whatsapp.com/JCiTWuZYOQ0Ez3EVnZggVg" target="_blank" rel="noopener">👥 Join Community</a>
          <a href="/faq">❓ FAQ</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style is:global>

/* ANIMATED GRADIENT BORDER */
@property --angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
@keyframes borderspin { to { --angle: 360deg; } }
.agb-wrap { border-radius: 20px; padding: 3px; background: conic-gradient(from var(--angle), var(--c1,#00a651), var(--c2,#0070f3), var(--c3,#00a651)); animation: borderspin 4s linear infinite; box-shadow: 0 8px 32px rgba(0,0,0,0.08); }
.agb-inner { background: #fff; border-radius: 18px; padding: 38px 28px; height: 100%; display: flex; flex-direction: column; align-items: center; text-align: center; }
.gs-step-badge { display: inline-flex; align-items: center; padding: 5px 14px; border-radius: 100px; font-size: 12px; font-weight: 700; letter-spacing: .5px; background: rgba(0,166,81,0.1); color: var(--accent); border: 1px solid rgba(0,166,81,0.2); margin-bottom: 14px; }
/* HERO */
.hero{position:relative;padding:100px 0 80px;overflow:hidden;}
.hero-bg{position:absolute;inset:0;pointer-events:none;background:linear-gradient(135deg,rgba(0,166,81,0.04) 0%,rgba(0,112,243,0.04) 100%);}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.hero-badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px;}
.hero-left h1{font-size:clamp(32px,4.5vw,56px);font-weight:800;line-height:1.1;margin-bottom:22px;color:var(--text);}
.hero-desc{font-size:17px;color:var(--muted);line-height:1.8;margin-bottom:30px;}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:18px;}
