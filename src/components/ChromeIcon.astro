---
interface Props { size?: number; class?: string; }
const { size = 18, class: cls = '' } = Astro.props;
---
<!-- Official Google Chrome icon SVG -->
<svg width={size} height={size} viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class={cls} style="flex-shrink:0;display:inline-block;">
  <!-- Red top segment -->
  <path d="M50 50 L50 15 A35 35 0 0 1 80.3 32.5 Z" fill="#EA4335"/>
  <!-- Blue left segment -->
  <path d="M50 50 L50 15 A35 35 0 0 0 19.7 32.5 Z" fill="#4285F4"/>
  <!-- Yellow right top -->
  <path d="M50 50 L80.3 32.5 A35 35 0 0 1 80.3 67.5 Z" fill="#FBBC05"/>
  <!-- Green bottom right -->
  <path d="M50 50 L80.3 67.5 A35 35 0 0 1 50 85 Z" fill="#34A853"/>
  <!-- Green bottom left -->
  <path d="M50 50 L50 85 A35 35 0 0 1 19.7 67.5 Z" fill="#34A853"/>
  <!-- Blue bottom left -->
  <path d="M50 50 L19.7 67.5 A35 35 0 0 1 19.7 32.5 Z" fill="#4285F4"/>
  <!-- White ring -->
  <circle cx="50" cy="50" r="22" fill="white"/>
  <!-- Inner blue circle -->
  <circle cx="50" cy="50" r="15" fill="#4285F4"/>
</svg>
