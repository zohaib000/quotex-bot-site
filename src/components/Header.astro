---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
  { href: '/faq', label: 'FAQ' },
];
const currentPath = Astro.url.pathname;
---
<header class="hdr">
  <div class="container hdr-inner">
    <a href="/" class="logo">
      <svg width="32" height="32" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <defs><linearGradient id="lg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#00a651"/><stop offset="100%" style="stop-color:#0070f3"/></linearGradient></defs>
        <rect width="100" height="100" rx="22" fill="url(#lg)"/>
        <text x="50" y="68" font-size="56" text-anchor="middle" font-family="Arial,sans-serif" fill="white" font-weight="bold">Q</text>
      </svg>
      <span>Quotex<strong>Bot</strong></span>
    </a>
    <nav class="nav">
      {navLinks.map(l => <a href={l.href} class={`nl ${currentPath===l.href?'active':''}`}>{l.label}</a>)}
    </nav>
    <div class="hdr-cta">
      <a href="https://chrome.google.com/webstore/detail/dbdhnfbjkakhilkkaoemgldcikboakdf" target="_blank" rel="noopener" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;"><path d="M50 50 L50 15 A35 35 0 0 1 80.3 32.5 Z" fill="#EA4335"/><path d="M50 50 L50 15 A35 35 0 0 0 19.7 32.5 Z" fill="#4285F4"/><path d="M50 50 L80.3 32.5 A35 35 0 0 1 80.3 67.5 Z" fill="#FBBC05"/><path d="M50 50 L80.3 67.5 A35 35 0 0 1 50 85 Z" fill="#34A853"/><path d="M50 50 L50 85 A35 35 0 0 1 19.7 67.5 Z" fill="#34A853"/><path d="M50 50 L19.7 67.5 A35 35 0 0 1 19.7 32.5 Z" fill="#4285F4"/><circle cx="50" cy="50" r="22" fill="white"/><circle cx="50" cy="50" r="15" fill="#4285F4"/></svg>
        Add to Chrome
      </a>
    </div>
    <button class="mbtn" id="mbtn" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
  <div class="mmenu" id="mmenu">
    {navLinks.map(l => <a href={l.href} class="ml">{l.label}</a>)}
    <a href="https://chrome.google.com/webstore/detail/dbdhnfbjkakhilkkaoemgldcikboakdf" target="_blank" rel="noopener" class="btn btn-primary" style="justify-content:center;">
      <svg width="18" height="18" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;"><path d="M50 50 L50 15 A35 35 0 0 1 80.3 32.5 Z" fill="#EA4335"/><path d="M50 50 L50 15 A35 35 0 0 0 19.7 32.5 Z" fill="#4285F4"/><path d="M50 50 L80.3 32.5 A35 35 0 0 1 80.3 67.5 Z" fill="#FBBC05"/><path d="M50 50 L80.3 67.5 A35 35 0 0 1 50 85 Z" fill="#34A853"/><path d="M50 50 L50 85 A35 35 0 0 1 19.7 67.5 Z" fill="#34A853"/><path d="M50 50 L19.7 67.5 A35 35 0 0 1 19.7 32.5 Z" fill="#4285F4"/><circle cx="50" cy="50" r="22" fill="white"/><circle cx="50" cy="50" r="15" fill="#4285F4"/></svg>
      Add to Chrome
    </a>
  </div>
</header>
<style is:global>
.hdr { position:sticky; top:0; z-index:100; width:100%; background:rgba(255,255,255,0.97); backdrop-filter:blur(12px); border-bottom:1px solid var(--border); }
.hdr-inner { display:flex; align-items:center; justify-content:space-between; height:64px; gap:16px; }
.logo { display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-size:18px; font-weight:500; color:var(--text); flex-shrink:0; }
.logo strong { color:var(--accent); font-weight:700; }
.nav { display:flex; align-items:center; gap:2px; flex:1; justify-content:center; }
.nl { padding:7px 13px; border-radius:7px; font-size:14px; font-weight:500; color:var(--muted); transition:all .2s; }
.nl:hover,.nl.active { color:var(--text); background:var(--bg2); }
.hdr-cta { flex-shrink:0; }
.mbtn { display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:8px; flex-shrink:0; }
.mbtn span { display:block; width:22px; height:2px; background:var(--text); border-radius:2px; }
.mmenu { display:none; flex-direction:column; gap:4px; padding:12px 24px 16px; border-top:1px solid var(--border); background:var(--bg); }
.ml { padding:10px 14px; border-radius:8px; font-weight:500; color:var(--muted); transition:all .2s; }
.ml:hover { color:var(--text); background:var(--bg2); }
.mmenu.open { display:flex; }
@media(max-width:960px){.nav,.hdr-cta{display:none;}.mbtn{display:flex;}}
</style>
<script>
const b=document.getElementById('mbtn'),m=document.getElementById('mmenu');
b?.addEventListener('click',()=>m?.classList.toggle('open'));
</script>
