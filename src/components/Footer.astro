<style is:global>
.ftr { background:var(--bg2); border-top:1px solid var(--border); padding:72px 0 36px; }
.ftr-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:48px; margin-bottom:56px; }
.ftr-logo { display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-size:18px; font-weight:500; color:var(--text); margin-bottom:16px; }
.ftr-logo strong { color:var(--accent); font-weight:700; }
.ftr-brand p { color:var(--muted); font-size:14px; line-height:1.7; margin-bottom:20px; }
.ftr-social { display:flex; flex-direction:column; gap:10px; }
.ftr-wa { display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:8px; font-size:13px; font-weight:600; color:#fff; transition:all .2s; }
.ftr-wa:hover { transform:translateY(-1px); }
.ftr-wa.support { background:#25D366; }
.ftr-wa.community { background:#128C7E; }
.ftr-col h4 { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--muted); margin-bottom:16px; }
.ftr-col ul { list-style:none; display:flex; flex-direction:column; gap:10px; }
.ftr-col ul a { font-size:14px; color:var(--muted); transition:color .2s; }
.ftr-col ul a:hover { color:var(--accent); }
.ftr-bottom { border-top:1px solid var(--border); padding-top:28px; display:flex; flex-direction:column; gap:12px; }
.ftr-bottom p { font-size:13px; color:var(--muted); }
.disclaimer { background:rgba(239,68,68,0.06); border:1px solid rgba(239,68,68,0.15); border-radius:8px; padding:12px 16px; font-size:12px !important; color:rgba(239,68,68,0.7) !important; }
@media(max-width:900px){ .ftr-grid { grid-template-columns:1fr 1fr; gap:32px; } .ftr-brand { grid-column:1/-1; } }
@media(max-width:560px){ .ftr-grid { grid-template-columns:1fr; } }
</style>
